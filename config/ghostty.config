# Srcery is the same palette as the Starship prompt (config/starship.toml).
theme = Srcery
background-opacity = 0.95
font-family = JetBrainsMono Nerd Font
font-size = 16

# Extra row height spaces the info line and the caret without inserting a blank
# prompt row, which would break the ╭─ ╰─ connector.
adjust-cell-height = 40%

# Blinking block, in the same green as the prompt caret.
cursor-style = block
cursor-style-blink = true
cursor-color = #98bc37
# Without this, shell integration switches the cursor to a bar at every prompt.
shell-integration-features = no-cursor
