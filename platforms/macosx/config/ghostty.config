# Srcery is the same palette as the Starship prompt (config/starship.toml).
theme = Srcery
background-opacity = 0.95
font-family = JetBrainsMono Nerd Font
font-size = 16

# Taller rows give the prompt breathing room between the info line and the caret.
# Powerline glyphs are adjusted with the cell height, so the segments stay aligned.
adjust-cell-height = 20%

# Blinking block, in the same green as the prompt caret.
cursor-style = block
cursor-style-blink = true
cursor-color = #98bc37
# Without this, shell integration switches the cursor to a bar at every prompt.
shell-integration-features = no-cursor
